# Azure Storage Connection String (Required)
# Get this from Azure Portal > Storage Account > Access keys
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=your_account;AccountKey=your_key;EndpointSuffix=core.windows.net

# Table Storage Connection String (Optional - defaults to above)
# AZURE_TABLE_STORAGE_CONNECTION_STRING=

# Blob Container Name for images (Optional - defaults to 'posts-images')
# BLOB_CONTAINER_NAME=posts-images

# Flask Secret Key (Required for production)
SECRET_KEY=your-super-secret-key-change-in-production

# Admin Key for /admin/reports (Optional - change in production)
# ADMIN_KEY=your-admin-key

# Flask Debug (Set to False in production)
# FLASK_DEBUG=False

# Port (Azure sets this automatically)
# PORT=8000